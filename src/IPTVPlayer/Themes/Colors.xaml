<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta de la app: base gris neutra con acentos naranjos del chucao. -->

    <SolidColorBrush x:Key="BgBrush" Color="#1A1A1E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#262629"/>
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#353538"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8752A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0924A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#888890"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
</ResourceDictionary>
