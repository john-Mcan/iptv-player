<Project>

  <!-- Propiedades comunes a todos los proyectos de la solución. -->
  <PropertyGroup>
    <Product>Chucao</Product>
    <Authors>John Moya C.</Authors>
    <Company>John Moya C.</Company>
    <Copyright>Copyright (c) 2026 John Moya C.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- En CI (GitHub Actions define CI=true) una advertencia rompe la compilación. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
