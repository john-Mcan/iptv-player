<Window x:Class="IPTVPlayer.Views.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuentes — Chucao"
        Width="680" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Icon="{StaticResource ChucaoIcon}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="SourceTypeTab" TargetType="RadioButton" BasedOn="{StaticResource ContentTabBtn}">
            <Setter Property="GroupName" Value="SourceType"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de fuentes guardadas -->
        <DockPanel Grid.Column="0" Margin="16,16,8,8">
            <TextBlock DockPanel.Dock="Top" Text="FUENTES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Nueva" Style="{StaticResource PlayerBtn}" Padding="12,6" Click="New_Click"/>
                <Button x:Name="DeleteButton" Content="Eliminar" Style="{StaticResource PlayerBtn}"
                        Padding="12,6" Margin="6,0,0,0" Click="Delete_Click"/>
            </StackPanel>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                <ListBox x:Name="SourceList" SelectionChanged="SourceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Type}" FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Formulario de la fuente seleccionada o nueva -->
        <StackPanel Grid.Column="1" Margin="8,16,20,8">
            <TextBlock Text="TIPO" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="M3uOption" Style="{StaticResource SourceTypeTab}"
                                 Content="Lista M3U" IsChecked="True" Checked="SourceType_Changed"/>
                    <RadioButton x:Name="XtreamOption" Style="{StaticResource SourceTypeTab}"
                                 Content="Xtream Codes" Checked="SourceType_Changed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}"
                     ToolTip="Opcional: si lo dejas vacío se usa el dominio o el nombre del archivo"/>

            <!-- M3U -->
            <StackPanel x:Name="M3uFields">
                <TextBlock Text="URL O ARCHIVO" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}"/>
                    <Button Grid.Column="1" Content="Examinar…" Style="{StaticResource PlayerBtn}"
                            Padding="10,6" Margin="6,0,0,0" Click="Browse_Click"/>
                </Grid>
            </StackPanel>

            <!-- Xtream Codes -->
            <StackPanel x:Name="XtreamFields" Visibility="Collapsed">
                <TextBlock Text="SERVIDOR" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ServerBox" Style="{StaticResource DarkTextBox}"
                         ToolTip="Por ejemplo: http://servidor.com:8080"/>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UserBox" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource DarkPasswordBox}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="La contraseña se guarda cifrada para tu usuario de Windows."
                           FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Guardar" Style="{StaticResource PlayerBtn}" Padding="16,6" Click="Save_Click"/>
                <TextBlock x:Name="MessageText" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
        </StackPanel>

        <!-- Pie -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar" Style="{StaticResource PlayerBtn}" Padding="20,8" Margin="0,0,8,0"
                        IsCancel="True" Click="Close_Click"/>
                <Button Content="Guardar y cargar" Style="{StaticResource AccentBtn}" Padding="20,8"
                        IsDefault="True" Click="Load_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
