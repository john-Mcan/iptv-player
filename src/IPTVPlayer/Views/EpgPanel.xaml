<UserControl x:Class="IPTVPlayer.Views.EpgPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Guía de programación del canal en reproducción (pestaña TV en vivo). -->
    <Border Background="{StaticResource SurfaceBrush}" Margin="2" DataContext="{Binding Epg}">
        <Grid>
            <!-- EPG placeholder (no data) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEpgData}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEpgLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="EPG" FontSize="20" FontWeight="Bold" Margin="0,8,0,2"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="Guía de Programación" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>

            <!-- EPG loading -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEpgLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Height="3" Width="160"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SurfaceHighBrush}" BorderThickness="0"/>
                <TextBlock Text="Cargando EPG..." FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>

            <!-- EPG programmes list -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEpgData}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,6,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="GUÍA DE PROGRAMACIÓN" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Programa actual y siguiente, cuando la guía los tiene -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="16,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentProgram}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="AHORA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   ToolTip="{Binding CurrentProgram.Description}">
                            <Run Text="{Binding CurrentProgram.Title, Mode=OneWay}"/>
                            <Run Text="{Binding CurrentProgram.TimeRange, Mode=OneWay, StringFormat='  {0}'}"
                                 Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NextProgram}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="A CONTINUACIÓN" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                       ToolTip="{Binding NextProgram.Description}">
                                <Run Text="{Binding NextProgram.Title, Mode=OneWay}"/>
                                <Run Text="{Binding NextProgram.TimeRange, Mode=OneWay, StringFormat='  {0}'}"
                                     Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="6,2,6,6">
                    <ItemsControl ItemsSource="{Binding CurrentEpgProgrammes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="170" Margin="3" Padding="8,6" CornerRadius="6"
                                        ToolTip="{Binding Description}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyAiring}" Value="True">
                                                    <Setter Property="Background" Value="#30E8752A"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#45E8752A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TimeRange}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                   MaxHeight="36" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
