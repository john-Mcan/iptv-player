<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Chucao</AssemblyTitle>
    <Description>Reproductor IPTV para Windows</Description>
    <!-- AssemblyVersion y FileVersion salen de Version; el workflow de release la toma del tag. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Al publicar para win-x64, copia solo la LibVLC de x64 (el paquete incluye x86 y arm64). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPTVPlayer.Core\IPTVPlayer.Core.csproj" />
  </ItemGroup>

</Project>
